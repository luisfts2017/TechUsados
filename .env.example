# OpenAI
OPENAI_API_KEY=sk-...

# Configurações do Bot
MINUTOS_COM_HUMANO=60
PAUSAR_FORA_DO_HORARIO=true
HORA_ABERTURA=8
HORA_FECHAMENTO=18

# GPT
GPT_MODEL=gpt-4o-mini
GPT_MAX_TOKENS=600
GPT_TEMPERATURE=0.5
GPT_TIMEOUT_MS=15000

# Banco de Dados
SQLITE_PATH=data/lia.db
REDIS_URL=redis://localhost:6379

# WhatsApp
WHATSAPP_SESSION_PATH=sessao_whatsapp

# Rate Limiting
RATE_LIMIT_MAX=8
RATE_LIMIT_SECS=60

# Fila
QUEUE_CONCURRENCY=5
QUEUE_TIMEOUT_MS=30000

# Monitoramento
HEALTH_PORT=3001

# Logs
LOG_FORMAT=pretty
LOG_LEVEL=info
